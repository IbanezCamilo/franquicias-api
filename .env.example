# Copia este archivo como .env y rellena los valores. El archivo .env NUNCA se versiona.

# Cadena de conexion a MongoDB.
# Local (docker-compose):
MONGODB_URI=mongodb://localhost:27017/franquicias
# MongoDB Atlas (produccion):
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/franquicias?retryWrites=true&w=majority

# Puerto HTTP de la aplicacion (Render lo inyecta automaticamente).
PORT=8080
